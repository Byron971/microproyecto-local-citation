# Entorno virtual de Python
.venv/

# Archivos temporales de Python
__pycache__/
*.py[cod]

# Archivos temporales de Jupyter
.ipynb_checkpoints/

# Seguimiento local de MLflow: cada integrante acumula sus propios runs y no
# deben versionarse. La base SQLite guarda métricas y parámetros; mlartifacts/
# los archivos (modelos, gráficas). Si el equipo levanta un servidor
# compartido, se configura con la variable de entorno MLFLOW_TRACKING_URI.
mlflow.db
mlartifacts/
mlruns/

# Cache de pytest
.pytest_cache/
.tox/
artifacts/

# Artefacto entrenado y salidas de construcción del paquete del modelo. El .pkl
# se regenera con `tox -e train` antes de construir el wheel; pesa decenas de MB
# y no se versiona.
model-package/modelo_citas/trained/*.pkl
model-package/dist/
model-package/build/
model-package/*.egg-info/
model-package/.tox/

# Variables de entorno y secretos
.env
.env.*

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db

# Archivos auxiliares generados al compilar reportes LaTeX
reportes/**/*.pdf
reportes/**/*.aux
reportes/**/*.fdb_latexmk
reportes/**/*.fls
reportes/**/*.log
reportes/**/*.lof
reportes/**/*.lot
reportes/**/*.out
reportes/**/*.synctex.gz
reportes/**/*.toc
reportes/**/*.bbl
reportes/**/*.blg

# Documentación de trabajo local
docs/
