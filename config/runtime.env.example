# Ejemplo SIN credenciales. No versionar el archivo .env con valores reales.
# Para Docker: docker compose --env-file config/runtime.env.example up --build
# Para local: exportar estas variables o iniciar uvicorn via "uv run tablero".
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info

# Los únicos backends realmente integrados a la API actual.
APP_RECOMMENDER_BACKEND=packaged_tfidf_linear
APP_TOP3_BACKEND=bm25_lexical
APP_MODEL_DEVICE=cpu

# Rutas relativas a la raíz del repositorio (en Docker, relativas a /app).
APP_INSIGHTS_PATH=data/processed/dashboard_insights.json
TOP3_CORPUS_PATH=proyecto_de_grado/artifacts/top3_s2/casos_train.json

# Puertos publicados por Compose: por defecto solo localhost (seguridad).
API_BIND_HOST=127.0.0.1
API_PUBLISHED_PORT=8000
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PUBLISHED_PORT=8080

# Clientes LLM para experimentación, no conectados a esta API web.
# Para modelos y claves de proveedores consultar config/citation_eval.env.example.
CITATION_PROVIDER_TIMEOUT_SECONDS=60

# Ruta científica EXPERIMENTAL: desactivada por defecto, no disponible en Docker ligero.
# Requiere instalar el paquete opcional recuperacion-densa + torch en el mismo Python
# de FastAPI y descargar previamente el snapshot SciBERT fijado por revisión.
# APP_SCIBERT_ENABLED=true
# APP_SCIBERT_MANIFEST=proyecto_de_grado/docs/evidencias_recuperacion_densa_a1/manifiesto_modelo.json
# APP_SCIBERT_DEVICE=cpu

# Experimento científico A4 en inferencia: TODOS apagados por defecto.
# Se requieren pesos históricos SHA, dependencias Torch y snapshot SciBERT.
# APP_A4_ENABLED=true
# APP_A4_RUN=proyecto_de_grado/artifacts/clasificacion_a4/corridas/scibert_A_42
# APP_A4_EVIDENCE=proyecto_de_grado/docs/evidencias_clasificacion_a4/scibert_A_42/manifiesto.json
# APP_A4_B_ENABLED=true
# APP_A4_B_RUN=proyecto_de_grado/artifacts/clasificacion_a4/corridas/scibert_B_42
# APP_A4_B_EVIDENCE=proyecto_de_grado/docs/evidencias_clasificacion_a4/scibert_B_42/manifiesto.json
# APP_A4_ENCODER_MANIFEST=proyecto_de_grado/docs/evidencias_clasificacion_a4/manifiesto_modelo_scibert.json
# APP_A4_DEVICE=cpu
# Limites de SciBERT (no cambian las rutas BM25 ni TF-IDF).
# APP_SCIENCE_MAX_CHUNKS=500
# APP_SCIENCE_MAX_CHARACTERS=600000
# APP_SCIBERT_CACHE_PAPERS=8
# APP_SCIBERT_CACHE_MAX_MB=64

# SPECTER A/B (segundo encoder de clasificación, no sustituye SciBERT Top-3).
# SOLO experimental, apagado por defecto. A y B necesitan model.safetensors
# auténticos SHA-verificados. El encoder SPECTER tiene revisión fija propia.
# APP_SPECTER_A_ENABLED=true
# APP_SPECTER_A_RUN=proyecto_de_grado/artifacts/clasificacion_a4/corridas/specter_A_42
# APP_SPECTER_A_EVIDENCE=proyecto_de_grado/docs/evidencias_clasificacion_a4/specter_A_42/manifiesto.json
# APP_SPECTER_B_ENABLED=true
# APP_SPECTER_B_RUN=proyecto_de_grado/artifacts/clasificacion_a4/corridas/specter_B_42
# APP_SPECTER_B_EVIDENCE=proyecto_de_grado/docs/evidencias_clasificacion_a4/specter_B_42/manifiesto.json
# APP_SPECTER_ENCODER_MANIFEST=proyecto_de_grado/docs/evidencias_clasificacion_a4/manifiesto_modelo_specter.json
# APP_SPECTER_DEVICE=cpu
# Para B también activar APP_SCIBERT_ENABLED y un snapshot SciBERT válido.
# Este ejemplo NO activa modelos ni expone datos Gold.
