# Ejemplo SIN credenciales. No versionar el archivo .env con valores reales.
# Para Docker: docker compose --env-file config/runtime.env.example up --build
# Para local: exportar estas variables o iniciar uvicorn via "uv run tablero".
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info

# Los únicos backends realmente integrados a la API actual.
APP_RECOMMENDER_BACKEND=packaged_tfidf_linear
APP_TOP3_BACKEND=bm25_lexical
APP_MODEL_DEVICE=cpu

# Rutas relativas a la raíz del repositorio (en Docker, relativas a /app).
APP_INSIGHTS_PATH=data/processed/dashboard_insights.json
TOP3_CORPUS_PATH=proyecto_de_grado/artifacts/top3_s2/casos_train.json

# Puertos publicados por Compose: por defecto solo localhost (seguridad).
API_BIND_HOST=127.0.0.1
API_PUBLISHED_PORT=8000
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PUBLISHED_PORT=8080

# Clientes LLM para experimentación, no conectados a esta API web.
# Para modelos y claves de proveedores consultar config/citation_eval.env.example.
CITATION_PROVIDER_TIMEOUT_SECONDS=60
