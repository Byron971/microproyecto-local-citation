# Copie estas variables a su entorno local. No escriba credenciales reales aquí.

# Modelo comercial OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Modelo comercial Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Modelo comercial Cohere mediante endpoint OpenAI-compatible
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# Modelo open-weight expuesto mediante un endpoint OpenAI-compatible
OPENWEIGHT_BASE_URL=http://localhost:11434/v1
OPENWEIGHT_MODEL=
OPENWEIGHT_API_KEY=local
